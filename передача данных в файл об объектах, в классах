def peredacha(stro):
    with open(".vscode\papka\info.txt", "a", encoding='utf-8') as file:
        file.write(stro)

class dog:
    name = None
    age = None
    isstrong = None
    def setinf(self, name, age, isstrong):
        self.name = name
        self.age = age
        self.isstrong = isstrong
    def getinf(self):
        return(f"Name of the dog: {self.name}\n Age of the dog: {self.age}\n Is dog strong: {self.isstrong}") 

while True:
    choice = input("номер собаки, информацию о которой вы хотите получить? 1-3. Enter 4 to end the programm: ")
    try:
        choice = int(choice)
        if choice == 1:
            dog1 = dog()
            dog1.setinf("mixo", 10, True)
            info = dog1.getinf()
            peredacha(info)
            continue
        elif choice == 2:
            dog2 = dog()
            dog2.setinf("pasha", 5, False)
            info2 = dog2.getinf()
            peredacha(info2)
            continue
        elif choice == 3:
            dog3 = dog()
            dog3.setinf("salah", 3, True)
            info3 = dog3.getinf()
            peredacha(info3)
            continue
        elif choice == 4:
            break
        elif choice > 4 or choice < 1:
            print("only numbers from 1 to 3")
    except ValueError:
        print("only numbers from 1 to 3 are allowed")
        
