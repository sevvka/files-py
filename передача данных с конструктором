def peredacha(inf):
    with open(".vscode\papka\lololo.txt", "a", encoding='utf-8') as file:
        file.write(inf)

class dog:
    name = None
    age = None
    isstrong = None
    def setinf(self, name, age, isstrong):
        self.name = name
        self.age = age
        self.isstrong = isstrong
    def getinf(self):
        return(f"Name of the dog: {self.name}\n Age of the dog: {self.age}\n Is dog strong: {self.isstrong}") 
    def __init__(self, name, age, isstrong):
        self.setinf(name, age, isstrong)
        self.getinf()
    
dog1 = dog("mixo", 10, True)

dog2 = dog("pasha", 5, False)

dog3 = dog("salah", 3, True)

dogs = {1: dog1, 2: dog2, 3: dog3}

while True:
    choice = input("номер собаки, информацию о которой вы хотите получить? 1-3. Enter 4 to end the programm: ")
    try:
        choice = int(choice)
        if choice == 1:
            dogy = dogs[1]
            info = dogy.getinf()
            peredacha(info)
        elif choice == 2:
            dogy = dogs[2]
            info = dogy.getinf()
            peredacha(info)
        elif choice == 3:
            dogy = dogs[3]
            info = dogy.getinf()
            peredacha(info)
        elif choice == 4:
            break
        elif choice > 4 or choice < 1:
            print("only numbers from 1 to 3")
    except ValueError:
        print("only numbers from 1 to 3 are allowed")
        
